{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": ".", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true, "types": ["node"]
  },
  "include": ["server/src/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
